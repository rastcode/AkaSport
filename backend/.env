# ---------------------------------------------------------------------------
# AkaSport backend environment (development defaults).
# The setup script copies this to `.env` and fills in a fresh SECRET_KEY.
# ---------------------------------------------------------------------------

# Security
DJANGO_SECRET_KEY=qLwSWPi2vL9p8M17rwo9hFnw9EQ9w81z5WLS5GdxlNBZS7HRda8MZVhZpNtvYpt3sFo
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS / CSRF â€” the Next.js storefront origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT lifetimes (minutes / days)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# OTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Run with ZERO external services (no Docker / Redis needed):
#   in-memory channel layer (chat works in a single dev process) + local cache.
# Set both to 0 and run Redis (see docker-compose.yml) for the full setup.
CHANNELS_IN_MEMORY=1
CACHE_IN_MEMORY=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Default OWNER account created by `python manage.py seed_owner`
DJANGO_OWNER_EMAIL=owner@akasport.local
DJANGO_OWNER_PHONE=+989120000000
DJANGO_OWNER_PASSWORD=Owner@12345

# --- Optional: PostgreSQL (leave POSTGRES_DB empty to use SQLite) ---
# POSTGRES_DB=akasport
# POSTGRES_USER=akasport
# POSTGRES_PASSWORD=akasport
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
