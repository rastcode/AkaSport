# ---------------------------------------------------------------------------
# AkaSport backend environment (development defaults).
# The setup script copies this to `.env` and fills in a fresh SECRET_KEY.
# ---------------------------------------------------------------------------

# Security (replace the secret and hosts in production)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS hardening applies only when DJANGO_DEBUG=false.
# Enable redirect/HSTS only after HTTPS is correctly terminated.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# JWT lifetimes (minutes / days)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# OTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Development defaults to in-memory backends when these variables are absent.
# Set both to false to exercise Redis locally; production defaults to Redis.
CHANNELS_IN_MEMORY=1
CACHE_IN_MEMORY=1
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Default OWNER account created by `python manage.py seed_owner`
DJANGO_OWNER_EMAIL=owner@akasport.local
DJANGO_OWNER_PHONE=+989120000000
DJANGO_OWNER_PASSWORD=Owner@12345

# Reserved for deployments that provide a database URL parser.
DATABASE_URL=

# --- Optional: PostgreSQL (leave POSTGRES_DB empty to use SQLite) ---
# POSTGRES_DB=akasport
# POSTGRES_USER=akasport
# POSTGRES_PASSWORD=akasport
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
