# Copy to `.env.local`. Public vars are exposed to the browser.
# Base URL of the Django REST backend (Parts 1-5).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# Public base URL serving uploaded media.
NEXT_PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:8000

# Cookie name prefix (override if you run multiple environments on one host).
NEXT_PUBLIC_COOKIE_PREFIX=akasport

# Public site origin — used for SEO (metadataBase, canonical, robots, sitemap, JSON-LD).
# In production set the real domain, e.g. https://akasport.ir
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional legacy allowlist for extra HTTPS image hosts (comma-separated).
NEXT_PUBLIC_MEDIA_HOSTS=
